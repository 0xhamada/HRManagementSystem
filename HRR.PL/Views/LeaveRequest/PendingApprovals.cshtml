@using HR.BLL.ModelVM.LeaveRequestVM
@model List<LeaveRequestListVM>
@{
    ViewData["Title"] = "Pending Leave Approvals";
}

<h2 class="mb-3">Pending Leave Approvals</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Leave Type</th>
            <th>Start</th>
            <th>End</th>
            <th>Reason</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.EmployeeName</td>
                <td>@r.LeaveTypeName</td>
                <td>@r.StartDate.ToShortDateString()</td>
                <td>@r.EndDate.ToShortDateString()</td>
                <td>@r.Reason</td>
                <td>
                    <form asp-action="Approve" asp-controller="LeaveRequest" method="post" class="d-inline">
                        <input type="hidden" name="requestid" value="@r.Id" />
                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                    </form>
                    <form asp-action="Reject" asp-controller="LeaveRequest" method="post" class="d-inline">
                        <input type="hidden" name="requestid" value="@r.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>