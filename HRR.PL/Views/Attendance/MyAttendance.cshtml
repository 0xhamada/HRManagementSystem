@using HR.BLL.ModelVM.AttendanceVM
@model List<AttendanceListVM>
@{
    ViewData["Title"] = "My Attendance";
    var today = ViewBag.Status as AttendanceListVM;
}
<h2 class="mb-3">My Attendance</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            @if (today == null)
            {
                <p class="mb-0">You haven't checked in today.</p>
            }
            else if (!today.IsCheckedOut)
            {
                <p class="mb-0">Checked in at <strong>@today.CheckInTime.ToShortTimeString()</strong> — still working.</p>
            }
            else
            {
                <p class="mb-0">
                    Checked in at <strong>@today.CheckInTime.ToShortTimeString()</strong>,
                    checked out at <strong>@today.CheckOutTime!.Value.ToShortTimeString()</strong>.
                </p>
            }
        </div>
        <div>
            @if (today == null)
            {
                <form asp-action="CheckIn" asp-controller="Attendance" method="post">
                    <button type="submit" class="btn btn-success">Check In</button>
                </form>
            }
            else if (!today.IsCheckedOut)
            {
                <form asp-action="CheckOut" asp-controller="Attendance" method="post">
                    <button type="submit" class="btn btn-danger">Check Out</button>
                </form>
            }
            else
            {
                <span class="badge bg-secondary">Done for today</span>
            }
        </div>
    </div>
</div>

<h4>History</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Check In</th>
            <th>Check Out</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Date.ToShortDateString()</td>
                <td>@a.CheckInTime.ToShortTimeString()</td>
                <td>@(a.CheckOutTime.HasValue ? a.CheckOutTime.Value.ToShortTimeString() : "—")</td>
            </tr>
        }
    </tbody>
</table>