@model ProfileVM
@{
    ViewData["Title"] = "My Profile";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="~/Images/@Model.Image" class="rounded-circle mb-3" width="120" height="120" alt="Profile" />
                }
                <h3>@Model.Name</h3>
                <p class="text-muted">@Model.JobTitle</p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Username:</strong> @Model.UserName</li>
                <li class="list-group-item"><strong>Email:</strong> @Model.Email</li>
                <li class="list-group-item"><strong>Email:</strong> @Model.Salary</li>

                <li class="list-group-item"><strong>Age:</strong> @Model.Age</li>
                <li class="list-group-item"><strong>Department:</strong> @(Model.DepartmentName ?? "Not assigned")</li>
                <li class="list-group-item"><strong>Hire Date:</strong> @Model.HireDate.ToShortDateString()</li>
            </ul>
        </div>
    </div>
</div>