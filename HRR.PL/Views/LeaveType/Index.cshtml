@using HR.BLL.ModelVM.LeaveRequestVM
@model List<LeaveTypeVM>

@{
    ViewData["Title"] = "Leave Types";
}

<h2 class="mb-3">Leave Types</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<a asp-action="Create" asp-controller="LeaveType" class="btn btn-primary mb-3"> Add Leave Type</a>

<table class="table table-dark">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-controller="LeaveType" asp-route-Id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
               
                    <form asp-action="Delete" asp-controller="LeaveType" method="post" asp-route-Id="@item.Id" class="d-inline" onsubmit="return confirm('Delete this leave type? This cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        
       
    </tbody>
</table>