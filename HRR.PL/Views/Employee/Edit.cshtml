@model EditEmployeeVM
@{ ViewData["Title"] = "Edit Employee"; }
@* <div class="app-content-header"><div class="container-fluid"><h3>Edit Employee</h3></div></div><div class="app-content"><div class="container-fluid"><div class="card card-primary"><form asp-action="Edit" method="post" enctype="multipart/form-data"><input asp-for="Id" type="hidden" /><input asp-for="Image" type="hidden" /><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="Age" class="form-label"></label><input asp-for="Age" class="form-control" /></div><div class="col-md-3 mb-3"><label asp-for="Salary" class="form-label"></label><input asp-for="Salary" class="form-control" /></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="DeptId" class="form-label">Department</label><select asp-for="DeptId" asp-items="ViewBag.Departments" class="form-select"></select></div><div class="col-md-6 mb-3"><label asp-for="NewImage" class="form-label">Replace image</label><input asp-for="NewImage" class="form-control" accept="image/*" /></div></div></div><div class="card-footer"><button class="btn btn-primary">Save changes</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></div></form></div></div></div> *@

<div class="app-content-header">
    <div class="container-fluid">
        <h3>Edit Employee</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card card-primary">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                <input asp-for="Image" type="hidden" />

                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Age" class="form-label"></label>
                            <input asp-for="Age" class="form-control" />
                            <span asp-validation-for="Age" class="text-danger"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label asp-for="Salary" class="form-label"></label>
                            <input asp-for="Salary" class="form-control" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                     <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DeptId" class="form-label">Department Id</label>
                        <input asp-for="DeptId" class="form-control" />

                            <span asp-validation-for="DeptId" class="text-danger"></span>
                        </div>
                        <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="department.Name" class="form-label">Department</label>
                             <input asp-for="department.Name" class="form-control" />
                            <span asp-validation-for="DeptId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NewImage" class="form-label">Replace image</label>
                            <input asp-for="NewImage" class="form-control" accept="image/*" />
                            <span asp-validation-for="NewImage" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>